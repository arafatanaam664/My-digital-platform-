  if (!tech) {
    const t = await orm.section.create({
      data: {
        slug: 'tech', name: 'التقنية والمعلومات', icon: '💻', order: 2, isActive: false,
        description: 'نيتش تجريبي خام — فعّله من لوحة التحكم عند استعدادك للتوسع في المحتوى التقني.',
      },
    });
    await orm.subsection.create({ data: { sectionId: t.id, slug: 'tech-articles', name: 'مقالات تقنية', type: 'articles', order: 1, isActive: true } });
    console.log('✔ demo section (inactive): التقنية والمعلومات');
  }

  console.log('\n✅ Seed complete. Admin login: admin@platform.local / Admin@12345');
}

// Direct-run entrypoint: npm run db:seed
if (process.argv[1] && process.argv[1].endsWith('seed.mts')) {
  (async () => {
    const d = createDriver();
    try {
      await runSeed(createOrm(d) as unknown as SeedOrm);
    } finally {
      d.close?.();
    }
  })().catch((e) => {
    console.error(e);
    process.exit(1);
  });
}
