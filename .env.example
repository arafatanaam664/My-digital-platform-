# ==== قاعدة البيانات ====
# محلي (تطوير): اتركه بلا DATABASE_URL أو ضع file:./dev.db  → SQLite تلقائياً
# إنتاج (Supabase): postgresql://postgres.<ref>:<password>@aws-0.<region>.pooler.supabase.com:5432/postgres
#DATABASE_URL="postgresql://user:pass@host:5432/postgres"

# ==== الجلسة ====
# سترها: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# ==== Cloudflare R2 (صور) — اختياري محلي، مطلوب في الإنتاج لزر الرفع ====
# Cloudflare → R2 → Manage R2 API Tokens → أنشئ Token بصلاحيات Object
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# رابط الدلو العام: فعّل Public Bucket واستخدم pub-xxxx.r2.dev/<bucket> أو نطاق CDN
NEXT_PUBLIC_R2_BASE_URL=""
